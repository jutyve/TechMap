# Copy this file to .env in the project root and fill in your own values.
# Keys stay on the backend; the browser never sees them. `.env` is git-ignored.
#
# Any OpenAI-compatible provider works. The OMNIROUTE_ names are kept for
# backwards compatibility. Without a reachable provider, AI features return an
# error while every non-AI directory feature keeps working.

OMNIROUTE_BASE_URL=https://your-provider.example/v1
OMNIROUTE_API_KEY=your-own-api-key
OMNIROUTE_MODEL=your-provider-model-id

# A local OmniRoute gateway would use:
# OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Optional server settings for run.py
# HOST=127.0.0.1
# PORT=8000
# RELOAD=1
